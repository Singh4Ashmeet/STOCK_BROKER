class EventReader:
    def __init__(
        self,
        files: list[str] | str,
        spec: InstrumentSpec | None = None,
        depth_levels: int = 10,
        vwap_window_secs: int = 60,
        trade_flow_window_secs: int = 60,
        skip_gaps: bool = False,
    ) -> None: ...
    @classmethod
    def open_file(
        cls,
        path: str,
        spec: InstrumentSpec | None = None,
        depth_levels: int = 10,
        vwap_window_secs: int = 60,
        trade_flow_window_secs: int = 60,
        skip_gaps: bool = False,
    ) -> EventReader: ...
    @classmethod
    def open_day(
        cls,
        base_dir: str,
        venue: str,
        symbol: str,
        date: str,
        spec: InstrumentSpec | None = None,
        depth_levels: int = 10,
        vwap_window_secs: int = 60,
        trade_flow_window_secs: int = 60,
        skip_gaps: bool = False,
    ) -> EventReader: ...
    def next_batch(self, batch_size: int = 10000) -> EventBatch | None: ...
    def summary(self) -> dict[str, Any]: ...
    @property
    def spec(self) -> InstrumentSpec: ...
    def __iter__(self) -> EventReader: ...
    def __next__(self) -> EventBatch: ...
