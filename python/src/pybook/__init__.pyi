"""Type stubs for pybook."""

from __future__ import annotations
from typing import TYPE_CHECKING, Any
import numpy as np
import numpy.typing as npt

if TYPE_CHECKING:
    import pyarrow as pa

__version__: str

def build_info() -> dict[str, str]: ...

class PyBookError(Exception): ...
class DataGapError(PyBookError): ...
class SchemaVersionError(PyBookError): ...

class InstrumentSpec:
    def __init__(
        self,
        price_scale: int,
        qty_scale: int,
        tick_size: int,
        lot_size: int,
        min_notional: int = 0,
    ) -> None: ...
    @property
    def price_scale(self) -> int: ...
    @property
    def qty_scale(self) -> int: ...
    @property
    def tick_size(self) -> int: ...
    @property
    def lot_size(self) -> int: ...
    @property
    def min_notional(self) -> int: ...
    def price_to_float(self, price_units: int) -> float: ...
    def qty_to_float(self, qty_units: int) -> float: ...
    def price_from_float(self, price: float) -> int: ...
    def qty_from_float(self, qty: float) -> int: ...

class OrderBook:
    def __init__(self, spec: InstrumentSpec, window_ticks: int = 2000) -> None: ...
    def apply_snapshot(
        self, bids: list[tuple[int, int]], asks: list[tuple[int, int]]
    ) -> None: ...
    def apply_delta(
        self, bids: list[tuple[int, int]], asks: list[tuple[int, int]]
    ) -> None: ...
    def best_bid(self) -> tuple[int, int] | None: ...
    def best_ask(self) -> tuple[int, int] | None: ...
    def mid(self) -> float | None: ...
    def spread(self) -> int | None: ...
    def depth_qty(self, side: str, n: int) -> int: ...
    def levels(self, side: str, n: int) -> list[tuple[int, int]]: ...
    def walk_market(
        self, side: str, target_qty: int
    ) -> tuple[int, int, list[tuple[int, int]]]: ...
    def checksum(self) -> int: ...

