<!-- infra/clickhouse/users.d/app-user.xml -->
<!-- ClickHouse user configuration for admin and low-privilege application user -->
<!-- This file is mounted into the container at /etc/clickhouse-server/users.d/ -->
<!-- Passwords are substituted from environment variables at container startup -->

<clickhouse>
    <users>
        <!-- Admin user (for migrations, admin tasks) -->
        <default>
            <password_sha256_hex>${SB_CLICKHOUSE_ADMIN_PASSWORD_SHA256}</password_sha256_hex>
            <access_management>1</access_management>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <default_database>stockbroker</default_database>
        </default>

        <!-- Application user (read-only access to stockbroker database) -->
        <sb_app>
            <password_sha256_hex>${SB_CLICKHOUSE_APP_PASSWORD_SHA256}</password_sha256_hex>
            <access_management>1</access_management>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <default_database>stockbroker</default_database>
        </sb_app>
    </users>

    <roles>
        <sb_ro>
            <access_management>1</access_management>
            <grants>
                <grant>
                    <database>stockbroker</database>
                    <table>*</table>
                    <access>SELECT</access>
                </grant>
            </grants>
        </sb_ro>
    </roles>

    <grants>
        <role>sb_ro</role>
        <to>
            <user>sb_app</user>
        </to>
    </grants>
</clickhouse>
