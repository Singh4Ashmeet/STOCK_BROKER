<!-- infra/clickhouse/users.d/app-user.xml.template -->
<!-- ClickHouse user configuration template for application user only -->
<!-- Admin user (default) is created via CLICKHOUSE_USER/CLICKHOUSE_PASSWORD env vars -->
<!-- Environment variables are substituted at container startup by 02-generate-users.sh -->

<clickhouse>
    <users>
        <!-- Application user (read-only access to stockbroker database) -->
        <sb_app>
            <password_sha256_hex>${SB_CLICKHOUSE_APP_PASSWORD_SHA256}</password_sha256_hex>
            <access_management>1</access_management>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <default_database>stockbroker</default_database>
        </sb_app>
    </users>

    <roles>
        <sb_ro>
            <access_management>1</access_management>
        </sb_ro>
    </roles>
</clickhouse>
