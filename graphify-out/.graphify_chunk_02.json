    {"id":"docs_adr_adr_0001_polyglot_split","label":"ADR-0001: Polyglot Split","file_type":"rationale","source_file":"C:\\dev\\stock_broker\\docs\\adr\\ADR-0001-polyglot-split.md","source_location":"## Decision","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Rust owns the low-latency feed, Java the product API, Python research and backtesting, and Next.js the frontend so each domain uses its natural language fit."},
    {"id":"docs_adr_adr_0002_direct_grpc_live_path","label":"ADR-0002: Direct gRPC Live Path","file_type":"rationale","source_file":"C:\\dev\\stock_broker\\docs\\adr\\ADR-0002-direct-grpc-live-path.md","source_location":"## Decision","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A direct Rust-to-Java gRPC stream minimizes live-path hops and operational weight; the message bus remains optional for later consumers."},
    {"id":"docs_adr_adr_0003_fixed_point_integers","label":"ADR-0003: Fixed-Point Integers","file_type":"rationale","source_file":"C:\\dev\\stock_broker\\docs\\adr\\ADR-0003-fixed-point-integers.md","source_location":"## Decision","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Scaled integers keep prices, quantities, balances, fills, and fees exact and deterministic across boundaries; floating point is restricted to derived analytics."},
    {"id":"docs_adr_adr_0004_optimized_book_with_oracle","label":"ADR-0004: Optimized Book with Oracle","file_type":"rationale","source_file":"C:\\dev\\stock_broker\\docs\\adr\\ADR-0004-optimized-book-with-oracle.md","source_location":"## Decision","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"A dense optimized order book pursues hot-path speed while a BTreeMap oracle and differential properties preserve correctness."},
    {"id":"docs_adr_adr_0005_pyo3_shared_book","label":"ADR-0005: PyO3 Shared Book","file_type":"rationale","source_file":"C:\\dev\\stock_broker\\docs\\adr\\ADR-0005-pyo3-shared-book.md","source_location":"## Decision","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The Rust book, metrics, and event reader are exposed to Python in coarse batches to avoid divergent live and backtest implementations."},
    {"id":"docs_adr_adr_0006_event_log_format","label":"ADR-0006: Event Log Format","file_type":"rationale","source_file":"C:\\dev\\stock_broker\\docs\\adr\\ADR-0006-event-log-format.md","source_location":"## Decision","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Framed Protobuf plus zstd supports cheap lossless hot-path appends and replay, while compaction to Parquet serves columnar research."},
    {"id":"docs_adr_adr_0007_auth_model","label":"ADR-0007: JWT and Rotating Refresh Tokens","file_type":"rationale","source_file":"C:\\dev\\stock_broker\\docs\\adr\\ADR-0007-auth-model.md","source_location":"## Decision","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Short-lived asymmetric JWTs and reuse-detecting rotating refresh tokens combine stateless hot-path validation with session revocation and theft detection."},
    {"id":"docs_adr_adr_0008_nextjs_client_only_live","label":"ADR-0008: Client-Only Next.js Live App","file_type":"rationale","source_file":"C:\\dev\\stock_broker\\docs\\adr\\ADR-0008-nextjs-client-only-live.md","source_location":"## Decision","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The static marketing site and client-only live application share Next.js while the browser connects directly to Java WebSocket to avoid a proxy hop."},
    {"id":"docs_adr_adr_0009_paper_trading_only","label":"ADR-0009: Paper Trading Only","file_type":"rationale","source_file":"C:\\dev\\stock_broker\\docs\\adr\\ADR-0009-paper-trading-only.md","source_location":"## Decision","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Simulating trades against live books avoids real-money, custody, investment-advice, and brokerage obligations without diluting the engineering goals."},
    {"id":"docs_adr_adr_0010_json_websocket_v1","label":"ADR-0010: JSON WebSocket v1","file_type":"rationale","source_file":"C:\\dev\\stock_broker\\docs\\adr\\ADR-0010-json-websocket-v1.md","source_location":"## Decision","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Compact JSON is native to browsers and easy to debug for v1; a future binary Protobuf protocol is reserved if measured browser parse cost warrants it."},
    {"id":"docs_adr_adr_0011_proto_codegen_strategy","label":"ADR-0011: Proto Codegen Strategy","file_type":"rationale","source_file":"C:\\dev\\stock_broker\\docs\\adr\\ADR-0011-proto-codegen-strategy.md","source_location":"## Decision","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Buf provides pinned schema linting, formatting, builds, and breaking checks, while native language build tools generate code without committing generated artifacts."},
    {"id":"docs_adr_adr_0012_crate_name_prefix","label":"ADR-0012: sb- Crate Name Prefix","file_type":"rationale","source_file":"C:\\dev\\stock_broker\\docs\\adr\\ADR-0012-crate-name-prefix.md","source_location":"## Decision","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"The sb- prefix avoids collision and import ambiguity with Rust's built-in core crate while retaining stable architecture directory names."}
