    {"id":"docs_13_development_guide_linux_filesystem_benchmarks","label":"Linux Filesystem Benchmark Requirement","file_type":"rationale","source_file":"C:\\dev\\stock_broker\\docs\\13-DEVELOPMENT-GUIDE.md","source_location":"### Filesystem and Environment","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Published benchmarks must be produced on a Linux filesystem because NTFS and OneDrive builds are slower or noisier and undermine credible performance results."},
