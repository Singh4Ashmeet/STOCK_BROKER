# .env.example - stock_broker local development environment variables
# Copy this file to .env and run ./scripts/bootstrap.sh to generate secrets
# NEVER commit .env to git - it is gitignored
# Prefix: SB_ (Stock Broker)

# ============================================================
# COMPOSE PROJECT SETTINGS
# ============================================================
COMPOSE_PROJECT_NAME=stockbroker
COMPOSE_PROFILES=core,analytics,obs

# ============================================================
# POSTGRES (core profile)
# ============================================================
SB_POSTGRES_PORT=5432
SB_POSTGRES_MIGRATOR_PASSWORD=CHANGE_ME_POSTGRES_MIGRATOR_PASSWORD
SB_POSTGRES_APP_PASSWORD=CHANGE_ME_POSTGRES_APP_PASSWORD
SB_POSTGRES_READONLY_PASSWORD=CHANGE_ME_POSTGRES_READONLY_PASSWORD

# ============================================================
# REDIS (core profile)
# ============================================================
SB_REDIS_PORT=6379
SB_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ============================================================
# CLICKHOUSE (analytics profile)
# ============================================================
SB_CLICKHOUSE_HTTP_PORT=8123
SB_CLICKHOUSE_NATIVE_PORT=9000
SB_CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE_PASSWORD
SB_CLICKHOUSE_APP_PASSWORD=CHANGE_ME_CLICKHOUSE_APP_PASSWORD
SB_CLICKHOUSE_APP_PASSWORD_SHA256=CHANGE_ME_CLICKHOUSE_APP_PASSWORD_SHA256

# ============================================================
# PROMETHEUS (obs profile)
# ============================================================
SB_PROMETHEUS_PORT=9090

# ============================================================
# GRAFANA (obs profile)
# ============================================================
SB_GRAFANA_PORT=3000
SB_GRAFANA_ADMIN_USER=admin
SB_GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD

# ============================================================
# REDPANDA (bus profile - optional, off by default)
# ============================================================
SB_REDPANDA_PORT=9092

# ============================================================
# JWT AUTHENTICATION (generated by bootstrap.sh)
# Ed25519 keypair stored in infra/secrets/
# ============================================================
SB_JWT_PRIVATE_KEY_PATH=infra/secrets/jwt_private.key
SB_JWT_PUBLIC_KEY_PATH=infra/secrets/jwt_public.key
SB_JWT_KID=2026-01
SB_JWT_ISSUER=stockbroker
SB_JWT_AUDIENCE=stockbroker-api
SB_JWT_ACCESS_TTL_MINUTES=15
SB_JWT_REFRESH_TTL_DAYS=30

# ============================================================
# INTERNAL SERVICE-TO-SERVICE TOKEN (generated by bootstrap.sh)
# ============================================================
SB_SERVICE_TOKEN=CHANGE_ME_SERVICE_TOKEN

# ============================================================
# APPLICATION PORTS (for future app profile services)
# These are documented here for reference; services don't exist yet
# ============================================================
# SB_FEED_PORT=9100
# SB_API_PORT=8081
# SB_RESEARCH_PORT=9101
# SB_WEB_PORT=3000

# ============================================================
# EXCHANGE / MARKET DATA (for future phases)
# ============================================================
# SB_BINANCE_WS_URL=wss://stream.binance.com:9443/ws
# SB_BINANCE_REST_URL=https://api.binance.com