# Stock Broker Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!
# This file is used by scripts/bootstrap.sh to generate secrets

# ============================================================
# PostgreSQL (core profile)
# ============================================================
SB_POSTGRES_PORT=5432
SB_POSTGRES_MIGRATOR_PASSWORD=CHANGE_ME_POSTGRES_MIGRATOR_PASSWORD
SB_POSTGRES_APP_PASSWORD=CHANGE_ME_POSTGRES_APP_PASSWORD
SB_POSTGRES_READONLY_PASSWORD=CHANGE_ME_POSTGRES_READONLY_PASSWORD

# ============================================================
# Redis (core profile)
# ============================================================
SB_REDIS_PORT=6379
SB_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ============================================================
# ClickHouse (analytics profile)
# ============================================================
SB_CLICKHOUSE_HTTP_PORT=8123
SB_CLICKHOUSE_NATIVE_PORT=9000
SB_CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE_PASSWORD
SB_CLICKHOUSE_APP_PASSWORD=CHANGE_ME_CLICKHOUSE_APP_PASSWORD
# SHA256 hash of the app user password (auto-generated by bootstrap.sh)
SB_CLICKHOUSE_APP_PASSWORD_SHA256=CHANGE_ME_CLICKHOUSE_APP_PASSWORD_SHA256

# ============================================================
# Prometheus (obs profile)
# ============================================================
SB_PROMETHEUS_PORT=9090

# ============================================================
# Grafana (obs profile)
# ============================================================
SB_GRAFANA_PORT=3000
SB_GRAFANA_ADMIN_USER=admin
SB_GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD

# ============================================================
# Redpanda (bus profile, optional)
# ============================================================
SB_REDPANDA_PORT=9092

# ============================================================
# Application Services (app profile)
# ============================================================
# Java API
SB_API_PORT=8081
SB_API_PROMETHEUS_PORT=8081

# Rust Feed
SB_FEED_PORT=9000
SB_FEED_PROMETHEUS_PORT=9100

# Python Research
SB_RESEARCH_PORT=9101
SB_RESEARCH_PROMETHEUS_PORT=9101

# Next.js Web
SB_WEB_PORT=3000

# ============================================================
# Service Token (for inter-service communication)
# ============================================================
SB_SERVICE_TOKEN=CHANGE_ME_SERVICE_TOKEN

# ============================================================
# JWT Keys (generated by scripts/bootstrap.sh)
# ============================================================
# Paths to keys (mounted as Docker secrets in compose)
SB_JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key
SB_JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key

# ============================================================
# Generated by bootstrap.sh (do not edit manually)
# ============================================================
# SB_BOOTSTRAPPED_AT=2026-10-10T00:00:00Z