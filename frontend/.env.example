# Stock Broker Frontend Environment Variables
# Copy to .env.local and fill in values

# API Configuration
# Server-only API origin used by Next.js route handlers and rewrites.  Keep
# secrets out of NEXT_PUBLIC_* variables: those are shipped to the browser.
API_URL=http://localhost:8081

# Optional browser-visible origin for code that must call the API directly.
# The current authentication flow uses same-origin /api/auth routes instead.
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_WS_URL=ws://localhost:8081

# App Configuration. Set this to the public HTTPS origin in preview and
# production; localhost is only the local-development default.
NEXT_PUBLIC_APP_NAME=Stock Broker
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_RESEARCH=true
NEXT_PUBLIC_ENABLE_ALERTS=true
